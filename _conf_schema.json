{
  "sign_time": {
    "description": "每日自动签到时间（北京时间，HH:MM）",
    "type": "string",
    "default": "09:00"
  },
  "push_result": {
    "description": "自动签到完成后推送给各账号的绑定会话",
    "type": "bool",
    "default": true
  },
  "enable_community_sign": {
    "description": "启用米游社社区签到",
    "type": "bool",
    "default": true
  },
  "community_forums": {
    "description": "社区签到板块 gids 列表（5=大别野）",
    "type": "list",
    "default": ["5"],
    "editor_mode": true
  },
  "games": {
    "description": "自动签到的游戏",
    "type": "object",
    "items": {
      "hk4e_cn": {"description": "原神", "type": "bool", "default": true},
      "hkrpg_cn": {"description": "崩坏：星穹铁道", "type": "bool", "default": true},
      "nap_cn": {"description": "绝区零", "type": "bool", "default": true},
      "bh3_cn": {"description": "崩坏3", "type": "bool", "default": true},
      "nxx_cn": {"description": "未定事件簿", "type": "bool", "default": false},
      "bh2_cn": {"description": "崩坏学园2", "type": "bool", "default": false}
    }
  },
  "web_ds_salt": {
    "description": "游戏签到 DS 盐（米游社接口更新时才需修改）",
    "type": "string",
    "default": "G1ktdwFL4IyGkHuuWSmz0wUe9Db9scyK",
    "invisible": true
  },
  "app_version": {
    "description": "米游社 App 版本（接口更新时才需修改）",
    "type": "string",
    "default": "2.106.2",
    "invisible": true
  },
  "api_retries": {
    "description": "临时网络失败时的重试次数",
    "type": "int",
    "default": 2
  },
  "qr_timeout": {
    "description": "米游社扫码登录二维码有效时间（秒）",
    "type": "int",
    "default": 120
  }
}
